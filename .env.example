# Supabase auth credentials (required)
# Create a project at https://supabase.com, then copy these from Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# App URL — used for OAuth callbacks and redirects
VITE_APP_URL="http://localhost:5173"

# Google Gemini AI (optional, for AI features)
GEMINI_API_KEY="your-gemini-api-key"

# Polar.sh payment integration (required for premium subscriptions)
# Sandbox (testing): use sandbox.polar.sh — create separate account, org, products & token there
# Production (live):  use polar.sh — swap API_URL, token, org & product IDs
POLAR_ACCESS_TOKEN="your-polar-access-token"
POLAR_ORGANIZATION_ID="your-polar-organization-id"
POLAR_PRODUCT_MONTHLY="your-monthly-product-id"
POLAR_PRODUCT_YEARLY="your-yearly-product-id"
POLAR_API_URL="https://sandbox-api.polar.sh"

# Supabase service role (required for webhook to update profiles)
# Get this from Supabase > Settings > API > service_role key (keep secret!)
SUPABASE_URL="${VITE_SUPABASE_URL}"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# API server URL (frontend calls this for checkout)
VITE_API_URL="http://localhost:4000"
